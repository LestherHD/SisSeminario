# ===== OBLIGATORIAS (mínimo para arrancar) =====
# Cadena de conexión de MongoDB (local o Atlas). Mongoose crea la BD solo.
MONGO_URI=mongodb://localhost:27017/sccvi
# Texto largo y aleatorio para firmar los tokens. Genéralo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ===== OPCIONALES =====
PORT=5000
# Notificaciones por Telegram
TELEGRAM_BOT_TOKEN=
# Correo transaccional (Brevo)
BREVO_API_KEY=
BREVO_REMITENTE=
# URL pública del frontend (enlaces y códigos QR)
FRONTEND_URL=http://localhost:5173
# Pon false para desactivar el análisis automático diario de alertas
ALERTAS_AUTOMATICAS=true
# Activa true solo detrás de un proxy confiable
TRUST_PROXY=false
